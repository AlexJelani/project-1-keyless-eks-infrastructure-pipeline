# Terraform variables for GCP GKE infrastructure
# Copy this file to terraform.tfvars and fill in your values

# GCP Project ID
gcp_project_id = "your-gcp-project-id"

# Region for resources
region = "us-central1"

# Cluster name
cluster_name = "keyless-eks"

# Kubernetes version
kubernetes_version = "1.31"

# VPC CIDR block
vpc_cidr = "10.10.0.0/16"

# Node pool configuration
node_pool_machine_type = "e2-medium"
min_nodes = 2
max_nodes = 4

# Artifact Registry configuration
artifact_registry_repo = "keyless-eks-app"

# GitHub Actions OIDC configuration
github_owner = "your-github-org"
github_repository = "your-repository"
github_branch = "main"

# Resource tags
tags = {
  Project = "keyless-eks"
  Environment = "dev"
  ManagedBy = "terraform"
}
